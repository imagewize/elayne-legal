{
	"name": "imagewize/elayne-legal",
	"description": "Child theme of Elayne for law firms: Legal Corporate and Legal Blue style variations, two-bar header, hero with enquiry form and filterable practice areas.",
	"type": "wordpress-theme",
	"license": "GPL-3.0-or-later",
	"authors": [
		{
			"name": "Jasper Frumau",
			"email": "jasper@imagewize.com"
		}
	],
	"require": {
		"php": ">=8.0",
		"imagewize/elayne": "*"
	},
	"require-dev": {
		"imagewize/pt-cli": "^2.6",
		"php-parallel-lint/php-parallel-lint": "^1.3",
		"wp-coding-standards/wpcs": "^3.0.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1"
	},
	"scripts": {
		"lint": "@php ./vendor/bin/parallel-lint --exclude .git --exclude vendor --exclude node_modules --exclude patterns .",
		"wpcs:scan": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs --ignore=*/vendor/*,*/patterns/*,*/node_modules/*,*.js,*.css --standard=WordPress .",
		"wpcs:fix": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcbf --ignore=*/vendor/*,*/patterns/*,*/node_modules/*,*.js,*.css --standard=WordPress .",
		"check": "@php ./vendor/bin/pt-cli check patterns/ --theme=elayne",
		"validate:new": "npm run validate:new",
		"validate:clear-cache": "npm run validate:clear-cache"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}

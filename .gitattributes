# Keeps source archives (GitHub's "Download source code", and the dist tarball
# Composer installs from) in step with .distignore, which governs the release
# zip. Keep this list in step with .distignore when either changes.
# README.md and CHANGELOG.md stay in source archives on purpose.

/docs export-ignore
/.tmp export-ignore
/.github export-ignore
/node_modules export-ignore
/vendor export-ignore
/.distignore export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
